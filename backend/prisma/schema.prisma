generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id       String           @id @db.VarChar(64)
  username      String           @unique @db.VarChar(255)
  password_hash String?         @db.Text
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  events        AnalyticsEvent[]

  @@map("users")
}

model Song {
  song_id            String           @id @db.VarChar(64)
  title              String           @db.VarChar(512)
  author             String           @db.VarChar(512)
  singer             String           @db.VarChar(512)
  genre              String           @db.VarChar(255)
  artwork_url        String           @db.Text
  duration_seconds   Int
  audio_url          String           @db.Text
  subgenre           String?          @db.VarChar(255)
  language           String?          @db.VarChar(64)
  release_year       Int?
  album_id           String?          @db.VarChar(64)
  artist_id          String?          @db.VarChar(64)
  featured_artists   String?          @db.Text
  region             String?          @db.VarChar(64)
  explicit_content   Boolean?
  popularity         Float?
  danceability       Float?
  energy             Float?
  loudness           Float?
  speechiness        Float?
  acousticness       Float?
  instrumentalness   Float?
  liveness           Float?
  valence            Float?
  tempo              Float?
  events             AnalyticsEvent[]

  @@index([genre], map: "ix_songs_genre")
  @@index([artist_id], map: "ix_songs_artist_id")
  @@map("songs")
}

model AnalyticsEvent {
  id                      BigInt    @id @default(autoincrement())
  user_id                 String    @db.VarChar(64)
  song_id                 String    @db.VarChar(64)
  occurred_at             DateTime  @db.Timestamptz(6)
  surface                 String    @db.VarChar(64)
  event_type              String    @db.VarChar(64)
  session_id              String    @db.VarChar(128)
  play_duration_seconds   Float?
  song_duration_seconds   Float?
  position                Int?
  request_id              String?   @db.VarChar(128)
  recommendation_id       String?   @db.VarChar(128)
  completed               Boolean?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  user                    User      @relation(fields: [user_id], references: [user_id], onDelete: Restrict)
  song                    Song      @relation(fields: [song_id], references: [song_id], onDelete: Restrict)

  @@index([user_id, occurred_at], map: "ix_analytics_events_user_occurred")
  @@index([song_id], map: "ix_analytics_events_song_id")
  @@index([event_type, surface], map: "ix_analytics_events_type_surface")
  @@index([session_id], map: "ix_analytics_events_session_id")
  @@map("analytics_events")
}
