# Copy to `.env.local` at this repo root (same folder as `README.md`).
# Next.js loads it via `frontend/next.config.mjs` (`loadEnvConfig` on the repo root).
# FastAPI loads it via `backend/app/config.py`.
# Docker Compose passes this file into the `api` service (`env_file`).

# Supabase Postgres — pooled (6543 / ?pgbouncer=true) vs direct (5432, no pgbouncer).
# Percent-encode special characters in the password inside the URL.
DATABASE_URL=
DIRECT_URL=

# Next.js → FastAPI when the browser runs on your machine (not inside Docker)
BACKEND_API_URL=http://localhost:8000

# Optional: comma-separated origins for FastAPI CORS (Compose also sets CORS for web:3000)
# CORS_ORIGINS=http://localhost:3000

# Optional: allow `python -m scripts.migrate_supabase` against local/Docker DB URLs
# ALLOW_LOCAL_MIGRATE=1
